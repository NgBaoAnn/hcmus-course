{
  "name": "hcmus-course-cli",
  "version": "0.1.3",
  "description": "Command-line client for HCMUS FIT Moodle Course",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NgBaoAnn/hcmus-course.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/NgBaoAnn/hcmus-course#readme",
  "bugs": "https://github.com/NgBaoAnn/hcmus-course/issues",
  "keywords": [
    "hcmus",
    "moodle",
    "course",
    "cli"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "type": "module",
  "bin": {
    "course": "dist/course.js"
  },
  "files": [
    "dist/*.js",
    "!dist/*.test.js",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "test": "npm run build && node --test dist/*.test.js",
    "start": "node dist/course.js",
    "prepare": "npm run build"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "linkedom": "^0.18.14"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2"
  }
}
